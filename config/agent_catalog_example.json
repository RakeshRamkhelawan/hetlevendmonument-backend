      },
      {
        "name": "Business Domain Metrics",
        "widgets": [
          "finance_workflow_completion",
          "hr_pipeline_velocity",
          "security_incident_response_time",
          "legal_compliance_score"
        ]
      }
    ],
    "alerting": {
      "channels": ["slack", "email", "pagerduty"],
      "severity_levels": ["info", "warning", "critical", "emergency"]
    }
  },

