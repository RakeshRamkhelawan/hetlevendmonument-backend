@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_get_dashboard_success(client):
    response = client.get("/api/dashboard/get_dashboard")
    assert response.status_code == 200
    assert "widgets" in response.json()

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_get_widget_success(client):
    response = client.get("/api/dashboard/get_widget/1")
    assert response.status_code == 200
    assert "widget" in response.json()

def test_get_widget_not_found(client):
    response = client.get("/api/dashboard/get_widget/999999")
    assert response.status_code == 404

