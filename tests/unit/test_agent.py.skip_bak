@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_create_agent_duplicate_name(client):
    client.post("/api/agents/", json={"name": "DupAgent", "type": "core"})
    response = client.post("/api/agents/", json={"name": "DupAgent", "type": "core"})
    assert response.status_code in (400, 409)

