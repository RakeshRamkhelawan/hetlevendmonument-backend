"""
Unit tests voor Agent domein: agent registratie, agent uitvoeren, edge cases
"""
import sys
import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))
import pytest
from fastapi.testclient import TestClient


@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_register_agent_success(client):
    response = client.post("/api/agent/register", json={
        "name": "TestAgent",
        "description": "Test agent description",
        "type": "basic"
    })
    assert response.status_code == 201
    assert "id" in response.json()

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_execute_agent_success(client):
    # Eerst agent registreren
    reg = client.post("/api/agent/register", json={
        "name": "ExecAgent",
        "description": "Agent for execution",
        "type": "basic"
    })
    agent_id = reg.json().get("id")
    # Dan uitvoeren
    response = client.post(f"/api/agent/execute/{agent_id}", json={"input": "test input"})
    assert response.status_code in (200, 202)
    assert "result" in response.json()

def test_execute_agent_not_found(client):
    response = client.post("/api/agent/execute/999999", json={"input": "test input"})
    assert response.status_code == 404

