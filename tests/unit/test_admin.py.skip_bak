"""
Unit tests voor Admin domein: admin user aanmaken, rechten toekennen, edge cases
"""
import sys
import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))
import pytest
from fastapi.testclient import TestClient


@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_create_admin_user_success(client):
    response = client.post("/api/admin/create_user", json={
        "username": "adminuser",
        "email": "admin@example.com",
        "password": "Admin1234!"
    })
    assert response.status_code == 201
    assert "id" in response.json()

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_assign_role_success(client):
    # Eerst admin user aanmaken
    reg = client.post("/api/admin/create_user", json={
        "username": "roleuser",
        "email": "roleuser@example.com",
        "password": "Role1234!"
    })
    user_id = reg.json().get("id")
    # Dan rol toekennen
    response = client.post(f"/api/admin/assign_role/{user_id}", json={"role": "editor"})
    assert response.status_code == 200
    assert response.json().get("role") == "editor"

def test_assign_role_user_not_found(client):
    response = client.post("/api/admin/assign_role/999999", json={"role": "editor"})
    assert response.status_code == 404

