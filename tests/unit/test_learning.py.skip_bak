"""
Unit tests voor Learning domein: leerproces starten, voortgang ophalen, edge cases
"""
import sys
import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))
import pytest
from fastapi.testclient import TestClient


@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_start_learning_success(client):
    response = client.post("/api/learning/start", json={
        "topic": "AI Ethics",
        "user_id": 1
    })
    assert response.status_code == 201
    assert "session_id" in response.json()

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_get_progress_success(client):
    reg = client.post("/api/learning/start", json={
        "topic": "Progress Test",
        "user_id": 2
    })
    session_id = reg.json().get("session_id")
    response = client.get(f"/api/learning/progress/{session_id}")
    assert response.status_code == 200
    assert "progress" in response.json()

def test_get_progress_not_found(client):
    response = client.get("/api/learning/progress/999999")
    assert response.status_code == 404

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_create_learning_missing_fields(client):
    response = client.post("/api/learning/", json={"title": ""})
    assert response.status_code in (400, 422)

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_create_learning_duplicate_title(client):
    client.post("/api/learning/", json={"title": "DupLearning"})
    response = client.post("/api/learning/", json={"title": "DupLearning"})
    assert response.status_code in (400, 409)

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_learning_boundary_values(client):
    long_title = "L" * 255
    response = client.post("/api/learning/", json={"title": long_title})
    assert response.status_code in (201, 400, 422)

