"""
Unit Tests: Tenant Isolation
PHASE 2 - TEST SUITE FOUNDATION

Tests verify:
1. ContextVar tenant_id propagation (no data leaks)
2. Query auto-filtering by tenant (SQLAlchemy hook)
3. JWT tenant_id claim validation
4. Permission-based access control (RBAC)
5. Feature flag enforcement

Coverage Target: 95% of isolation logic
Execution: pytest tests/unit/test_tenant_isolation.py -v
"""

import pytest
import json
from datetime import datetime, timedelta
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from core.middleware.tenant_middleware import current_tenant_id, current_user_id
from core.auth.jwt_handler import jwt_handler
from core.database.models import (
    Tenant, User, Agent, Conversation, AuditLog,
    FeatureFlag, TenantConfig
)
from core.feature_flags.manager import FeatureFlagManager, Feature, Tier
from core.auth.rbac_service import RBACService, Role, Permission
from core.shared.interfaces import User as UserInterface


