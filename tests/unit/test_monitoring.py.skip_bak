import sys
import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))
import pytest
from fastapi.testclient import TestClient


@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_get_metrics_success(client):
    response = client.get("/api/monitoring/metrics")
    assert response.status_code == 200
    assert "metrics" in response.json()

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_trigger_alert_success(client):
    response = client.post("/api/monitoring/trigger_alert", json={"alert_type": "test"})
    assert response.status_code in (200, 201)
    assert "alert_id" in response.json()

def test_get_alert_not_found(client):
    response = client.get("/api/monitoring/alert/999999")
    assert response.status_code == 404

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_monitoring_endpoint_health(client):
    response = client.get("/api/monitoring/health")
    assert response.status_code == 200
    assert response.json().get("status") in ("ok", "healthy")

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_monitoring_metrics_format(client):
    response = client.get("/api/monitoring/metrics")
    assert response.status_code == 200
    assert "application/json" in response.headers.get("content-type", "") or "text/plain" in response.headers.get("content-type", "")

