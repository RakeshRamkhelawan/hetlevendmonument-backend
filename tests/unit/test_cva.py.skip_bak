@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_create_cva_duplicate_name(client):
    client.post("/api/cva/", json={"name": "DupCVA"})
    response = client.post("/api/cva/", json={"name": "DupCVA"})
    assert response.status_code in (400, 409)

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_cva_boundary_values(client):
    long_name = "C" * 255
    response = client.post("/api/cva/", json={"name": long_name})
    assert response.status_code in (201, 400, 422)

