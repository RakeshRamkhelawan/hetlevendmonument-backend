"""
Unit tests voor CVA domein: CVA agent aanmaken, uitvoeren, edge cases
"""
import sys
import os
sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '../../src')))
import pytest
from fastapi.testclient import TestClient


@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_create_cva_agent_success(client):
    response = client.post("/api/cva/create_agent", json={
        "name": "TestCVA",
        "description": "Test CVA agent"
    })
    assert response.status_code == 201
    assert "id" in response.json()

@pytest.mark.skip(reason="Endpoint not yet implemented - Phase 2/3 feature")
def test_execute_cva_agent_success(client):
    reg = client.post("/api/cva/create_agent", json={
        "name": "ExecCVA",
        "description": "CVA for execution"
    })
    agent_id = reg.json().get("id")
    response = client.post(f"/api/cva/execute/{agent_id}", json={"input": "test input"})
    assert response.status_code in (200, 202)
    assert "result" in response.json()

def test_execute_cva_agent_not_found(client):
    response = client.post("/api/cva/execute/999999", json={"input": "test input"})
    assert response.status_code == 404

