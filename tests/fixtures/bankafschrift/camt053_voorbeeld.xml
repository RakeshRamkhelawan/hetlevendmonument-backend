            <RmtInf><Ustrd>Betaling factuur F-2026-001 met dank</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 2. Factuurnummer in de omschrijving, gelijk bedrag, vordering staat op herinnerd: wordt afgevinkt. -->
      <Ntry>
        <Amt Ccy="EUR">250.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>BOOK</Sts>
        <BookgDt><Dt>2026-10-06</Dt></BookgDt>
        <NtryDtls>
          <TxDtls>
            <RmtInf><Ustrd>F-2026-002</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 3. Factuurnummer klopt maar het bedrag wijkt af (99,99 tegenover 100,00): NIET afvinken. -->
      <Ntry>
        <Amt Ccy="EUR">99.99</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>BOOK</Sts>
        <BookgDt><Dt>2026-10-07</Dt></BookgDt>
        <NtryDtls>
          <TxDtls>
            <RmtInf><Ustrd>Factuur F-2026-003</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 4. Twee facturen met hetzelfde bedrag in een omschrijving: twee mogelijke facturen, NIET afvinken. -->
      <Ntry>
        <Amt Ccy="EUR">50.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>BOOK</Sts>
        <BookgDt><Dt>2026-10-08</Dt></BookgDt>
        <NtryDtls>
          <TxDtls>
            <RmtInf><Ustrd>Facturen F-2026-004 en F-2026-005</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 5. Een afschrijving (debet): telt niet mee. -->
