          <TxDtls>
            <RmtInf><Ustrd>Cadeau voor het team</Ustrd></RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
      <!-- 7. Het factuurnummer staat in het betalingskenmerk (gestructureerd), niet in de vrije omschrijving. -->
      <Ntry>
        <Amt Ccy="EUR">60.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>BOOK</Sts>
        <BookgDt><Dt>2026-10-11</Dt></BookgDt>
        <NtryDtls>
          <TxDtls>
            <RmtInf>
              <Strd><CdtrRefInf><Ref>F-2026-006</Ref></CdtrRefInf></Strd>
            </RmtInf>
          </TxDtls>
        </NtryDtls>
      </Ntry>
