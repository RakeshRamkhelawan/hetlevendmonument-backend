      <!-- 1. Bijschrijving met factuurnummer in de omschrijving en een gelijk bedrag: wordt afgevinkt. -->
      <Ntry>
        <Amt Ccy="EUR">121.00</Amt>
        <CdtDbtInd>CRDT</CdtDbtInd>
        <Sts>BOOK</Sts>
        <BookgDt><Dt>2026-10-05</Dt></BookgDt>
