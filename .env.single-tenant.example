# Voorbeeldconfiguratie voor single-tenant deployment (ADR-035).
#
# Gebruik:  cp .env.single-tenant.example .env   en vul de VERPLICHTE waarden in.
# Zie docs/deployment/single-tenant-guide.md voor de volledige procedure.
#
# Dit bestand staat IN git en bevat daarom uitsluitend placeholders. Zet je echte
# waarden alleen in .env -- dat bestand is genegeerd.

# ==================== DEPLOYMENT ====================
DEPLOYMENT_MODE=single_tenant
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ==================== VERPLICHT ====================
# Genereer beide met: openssl rand -hex 32
SECRET_KEY=vervang-dit-openssl-rand-hex-32
JWT_SECRET_KEY=vervang-dit-openssl-rand-hex-32

# Pseudonimiseert tool-payloads in de auditketen (ADR-036 OP-27). Zonder deze waarde
# WEIGERT de backend op te starten in production en staging -- hij staat in
# PRODUCTION_REQUIRED_VARS, dus je krijgt een harde bootfout en geen stille storing.
#
# Genereer met:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# De code eist minimaal 32 tekens, minimaal 8 verschillende tekens, en geen herhaald
# blok. Verzin hem niet zelf: die controle is geen raadbaarheidstoets en laat een
# zwakke sleutel als "sanskritisetu-key-2026" gewoon door.
#
# LET OP -- dit is geen gewoon wachtwoord. Verander je hem later, dan zijn ALLE eerder
# vastgelegde auditkenmerken onvergelijkbaar met de nieuwe. Dat spoor is precies wat
# AI Act art. 12(2) van je vraagt, dus dat is bewijsverlies en geen ongemak. Bewaar hem
# buiten deze server, en gebruik een ANDERE waarde per omgeving: dezelfde sleutel in
# staging en productie betekent dat wie staging kan lezen de productielogs terugrekent.
TOOL_PAYLOAD_PSEUDONYM_KEY=vervang-dit-secrets-token-urlsafe-32

# Sterk wachtwoord voor PostgreSQL. Wordt HERGEBRUIKT als Redis-wachtwoord:
# docker-compose.single-tenant.yml geeft het door aan --requirepass, dus zonder deze
# waarde start de Redis-container niet.
DB_PASSWORD=vervang-dit-sterk-wachtwoord

# Eerste beheerder. Wachtwoord minimaal 16 tekens.
DEFAULT_ADMIN_EMAIL=admin@vervang-dit.nl
DEFAULT_ADMIN_PASSWORD=vervang-dit-minimaal-16-tekens

# Jouw frontend-domein. NOOIT leeg en NOOIT `*` -- dat is een beveiligingsvereiste
# (SEC-001): een wildcard-origin naast credentials maakt CSRF mogelijk.
CORS_ALLOWED_ORIGINS=https://app.vervang-dit.nl

# ==================== DATABASE ====================
DB_USER=postgres
DB_NAME=sanskritisetu
DATABASE_URL=postgresql+asyncpg://postgres:vervang-dit-sterk-wachtwoord@postgres:5432/sanskritisetu

# ==================== REDIS ====================
# Zelfde wachtwoord als DB_PASSWORD hierboven.
REDIS_URL=redis://:vervang-dit-sterk-wachtwoord@redis:6379/0
DRAMATIQ_BROKER_URL=redis://:vervang-dit-sterk-wachtwoord@redis:6379/1

# ==================== FRONTEND ====================
FRONTEND_URL=https://app.vervang-dit.nl

# ==================== OPTIONEEL -- LLM-PROVIDERS ====================
# Laat leeg als je geen externe LLM gebruikt. Let op: staat hier een sleutel, dan
# gebruiken agents die daadwerkelijk, met bijbehorende kosten.
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ==================== OPTIONEEL -- E-MAIL ====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
